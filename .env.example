# ─────────────────────────────────────────────────────────────
# FoC — Friend on Campus · Environment configuration (EXAMPLE)
# ─────────────────────────────────────────────────────────────
# Copy to `.env` and fill in real values:   cp .env.example .env
#
# `.env` is git-ignored — NEVER commit real secrets.
# Any variable read by any service MUST appear here with a safe
# placeholder so teammates know what to set.
#
# This is just an example; you can add more variables as needed.
# ─────────────────────────────────────────────────────────────

# ---- Global -------------------------------------------------
LOG_LEVEL=

# ---- Local RabbitMQ (root Compose configuration) -----------
# Development defaults only. Match credentials in both services' RABBITMQ_URL.
# These initialize a fresh broker volume, not existing broker users.
RABBITMQ_USER=foc
RABBITMQ_PASSWORD=foc-local-only

# ---- Auth / JWT -----------
JWT_SECRET=
JWT_ACCESS_TOKEN_TTL=
JWT_REFRESH_TOKEN_TTL=

# ... Add more variables as needed

# ---- User service: optional first-admin bootstrap -----------
# Configure in user-service/.env or its deployment environment.
# Leave all empty to disable; remove credentials after success.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PHONE_NUMBER=
BOOTSTRAP_ADMIN_PASSWORD=
