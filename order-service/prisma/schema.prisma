// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OrderStatus {
  OPEN
  ACCEPTED
  PICKED_UP
  COMPLETED
  RECEIVED
  CANCELED
  EXPIRED
  FAILED
}

enum OrderEventType {
  ORDER_OPENED // Notify users of new orders, credit service reserve requester credits
  ORDER_CANCELED // Credit service release the reserved credits
  ORDER_COMPLETED // Notify requester of order completion
  ORDER_EXPIRED // Credit service release the reserved credits
  ORDER_RECEIVED // Credit service transfer the credits to the courier
  ORDER_FAILED // Credit service release the reserved credits
}

model Order {
  id String @id @default(uuid()) @db.Uuid

  // IDs owned by user service
  requesterId String  @db.Uuid
  courierId   String? @db.Uuid

  // Order request details
  name        String @db.VarChar(255)
  description String @db.VarChar(500)

  // IDs owned by supplier service
  pickupSupplierId   String @db.Uuid
  deliverySupplierId String @db.Uuid

  offeredCredits Int

  // Optional remarks from requester
  remarks String? @db.Text

  // Lifecycle 
  status         OrderStatus @default(OPEN)
  expiryAt       DateTime    @db.Timestamptz(6)

  // Optimistic concurrency control
  version Int @default(1)

  // General timestamps
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  acceptedAt  DateTime? @db.Timestamptz(6)
  pickedUpAt  DateTime? @db.Timestamptz(6)
  completedAt DateTime? @db.Timestamptz(6)
  receivedAt  DateTime? @db.Timestamptz(6)
  cancelledAt DateTime? @db.Timestamptz(6)
  expiredAt   DateTime? @db.Timestamptz(6)
  failedAt    DateTime? @db.Timestamptz(6)

  // Reasons
  cancellationReason String? @db.Text
  failureReason      String? @db.Text

  // Relationships
  statusHistory OrderStatusHistory[]
  outboxEvents  OutboxEvent[]

  // Browse open orders
  @@index([status, expiryAt])
  // Sort by offered credits
  @@index([status, offeredCredits])
  // Filter by pickup location
  @@index([status, pickupSupplierId, expiryAt])
  // Filter by delivery location
  @@index([status, deliverySupplierId, expiryAt])
  // Requester history
  @@index([requesterId, createdAt])
  // Courier history
  @@index([courierId, createdAt])
}

model OrderStatusHistory {
  id String @id @default(uuid()) @db.Uuid

  orderId String @db.Uuid

  fromStatus OrderStatus?
  toStatus   OrderStatus

  // ID of the user who caused the transition.
  // NULL for system-generated transitions such as expiry.
  changedBy String? @db.Uuid

  reason String? @db.Text

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
}

model OutboxEvent {
  id String @id @default(uuid()) @db.Uuid

  orderId String @db.Uuid

  eventType OrderEventType

  // Useful if you change event format later
  eventVersion Int @default(1)

  // Actual event payload to be published to RabbitMQ
  payload Json

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  // NULL means it has not successfully been published
  publishedAt DateTime? @db.Timestamptz(6)

  // For error handling
  retryCount Int @default(0)

  // Last error message from RabbitMQ
  lastError String? @db.Text

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([publishedAt, createdAt])
  @@index([orderId])
}
