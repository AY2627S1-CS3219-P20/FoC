# ─────────────────────────────────────────────────────────────
# FoC — Friend on Campus · Environment configuration (EXAMPLE)
# ─────────────────────────────────────────────────────────────
# Copy to `.env` and fill in real values:   cp .env.example .env
#
# `.env` is git-ignored — NEVER commit real secrets.
# Any variable read by any service MUST appear here with a safe
# placeholder so teammates know what to set.
#
# This is just an example; you can add more variables as needed.
# ─────────────────────────────────────────────────────────────

# ---- Server -----------------------------------------------
PORT=3002
NODE_ENV=development
FRONTEND_URL="http://localhost:5173"
SUPPLIER_SERVICE_URL="http://localhost:3001"
CREDIT_SERVICE_URL="http://localhost:3003"

# ---- Database -----------------------------------------------
DATABASE_URL="postgresql://username:password@localhost:5432/order_db?sslmode=require"

# ---- RabbitMQ ---------------------------------------------
# Used by the background registration consumer and standalone redrive command.
# Local Compose defaults. Use rabbitmq instead of localhost inside Compose.
# Percent-encode special characters in URL credentials.
RABBITMQ_URL="amqp://foc:foc-local-only@localhost:5672?heartbeat=20"

# ---- Auth / JWT -----------
JWT_PUBLIC_KEY_PATH=your_public_key_path_here

# Internal Order integration (private ingress only; HTTPS/TLS in deployment)
ORDER_CREDIT_SERVICE_TOKEN="replace-with-a-random-service-secret"
ORDER_SUPPLIER_SERVICE_TOKEN="replace-with-a-random-service-secret"