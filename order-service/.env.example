# ─────────────────────────────────────────────────────────────
# FoC — Friend on Campus · Environment configuration (EXAMPLE)
# ─────────────────────────────────────────────────────────────
# Copy to `.env` and fill in real values:   cp .env.example .env
#
# `.env` is git-ignored — NEVER commit real secrets.
# Any variable read by any service MUST appear here with a safe
# placeholder so teammates know what to set.
#
# This is just an example; you can add more variables as needed.
# ─────────────────────────────────────────────────────────────

# ---- Server -----------------------------------------------
# These addresses are for order-service running in the root Compose stack.
PORT=3002
NODE_ENV=development
FRONTEND_URL="http://localhost:5173"
SUPPLIER_SERVICE_URL="http://supplier-service:3001"
CREDIT_SERVICE_URL="http://credit-service:3003"

# ---- Database -----------------------------------------------
ORDER_POSTGRES_DB=orders
ORDER_POSTGRES_USER=foc_order
ORDER_POSTGRES_PASSWORD=your_postgres_password
# Keep the credentials and database name below in sync with ORDER_POSTGRES_*.
# Percent-encode special characters in URL credentials.
DATABASE_URL="postgresql://foc_order:your_postgres_password@order-postgres:5432/orders?sslmode=disable"

# ---- RabbitMQ ---------------------------------------------
# Used by the order outbox publisher. Match the root RabbitMQ credentials.
# Percent-encode special characters in URL credentials.
RABBITMQ_URL="amqp://foc:foc-local-only@rabbitmq:5672?heartbeat=20"

# ---- Auth / JWT -----------
JWT_PUBLIC_KEY_PATH=/app/keys/public.pem

# Internal Order integration (private ingress only; HTTPS/TLS in deployment)
ORDER_CREDIT_SERVICE_TOKEN="replace-with-a-random-service-secret"
ORDER_SUPPLIER_SERVICE_TOKEN="replace-with-a-random-service-secret"
