# ─────────────────────────────────────────────────────────────
# FoC — Friend on Campus · Environment configuration (EXAMPLE)
# ─────────────────────────────────────────────────────────────
# Copy to `.env` and fill in real values:   cp .env.example .env
#
# `.env` is git-ignored — NEVER commit real secrets.
# Any variable read by any service MUST appear here with a safe
# placeholder so teammates know what to set.
#
# This is just an example; you can add more variables as needed.
# ─────────────────────────────────────────────────────────────

# ---- Server -----------------------------------------------
PORT=3000
NODE_ENV=development
FRONTEND_URL="http://localhost:5173"

# ---- Database -----------------------------------------------
DATABASE_URL="postgresql://username:password@localhost:5432/users?sslmode=require"

# ---- RabbitMQ ---------------------------------------------
# Background outbox publisher; read from this service's .env, not the root .env.
# Local Compose defaults. Use rabbitmq instead of localhost inside Compose.
# Percent-encode special characters in URL credentials.
RABBITMQ_URL="amqp://foc:foc-local-only@localhost:5672?heartbeat=20"

# ---- Auth / JWT -----------
JWT_PRIVATE_KEY_PATH=./keys/private.pem
JWT_PUBLIC_KEY_PATH=./keys/public.pem
JWT_REFRESH_TOKEN_KEY=your_refresh_token_secret_here
COOKIE_SECRET=your_cookie_secret_here

# ---- First administrator ----------------------------------
# Optional first-admin bootstrap. Leave all four empty to disable.
# Set all four for first startup only; remove them after success.
# Existing accounts are never promoted or overwritten by bootstrap.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PHONE_NUMBER=
BOOTSTRAP_ADMIN_PASSWORD=

# ---- Registration email / Brevo SMTP -----------------------
# Use the SMTP login and SMTP key from Brevo's transactional settings.
# EMAIL_FROM must be a sender address verified in Brevo.
BREVO_SMTP_USER=your_brevo_smtp_login
BREVO_SMTP_KEY=your_brevo_smtp_key
EMAIL_FROM="Aaron <your-verified-sender@example.com>"
