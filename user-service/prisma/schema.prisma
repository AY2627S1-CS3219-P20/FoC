// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  ADMIN
}

model User {
  userId      String   @id @default(uuid())
  email       String   @unique
  username    String   @unique
  password    String
  phoneNumber String   @unique
  role        Role     @default(STUDENT)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  refreshTokens RefreshToken[]
}

model RefreshToken {
  id        String    @id @default(uuid()) // Primary key for the RefreshToken table
  tokenId   String    @unique // Unique identifier for the refresh token
  tokenHash String    @unique // Actual hashed refresh token value
  userId    String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId])
}

model PendingRegistration {
  challengeId    String    @id @default(uuid())
  email          String    @unique
  username       String
  phoneNumber    String
  // Nullable so secrets can be cleared after consumption or expiry.
  passwordHash   String?
  otpHash        String?
  expiresAt      DateTime
  failedAttempts Int       @default(0)
  emailSentAt    DateTime?
  consumedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([expiresAt])
}

model RegistrationOtpRequest {
  id          String   @id @default(uuid())
  // Independent of the challenge so replacing it cannot reset the request quota.
  email       String
  requestedAt DateTime @default(now())

  @@index([email, requestedAt])
  @@index([requestedAt])
}
